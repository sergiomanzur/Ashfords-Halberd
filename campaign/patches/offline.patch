+#if defined(TARGET_PC) && defined(__LP64__)
+/* The decomp's effect draw loops take `unsigned int*` and stride 4 bytes per
+   pointer (32-bit PS2 layout). On LP64 SYS_WORK's ef_* arrays are O_WRK*[N]
+   with 8-byte entries, so the 4-byte stride reads the high half of a pointer
+   (zero for a window address) on every other iteration -> NULL op deref.
+   Flatten the low 32 bits into a stack array before calling the unchanged
+   32-bit-stride loop. All game pointers are window addresses (< 4 GiB). */
+#define EF_DRAW_LIST(fn, arr, n) do {                                  \
+        uint32_t ef_flat[512];                                         \
+        int ef_n_ = (int)(n);                                          \
+        int ef_i_;                                                     \
+        if (ef_n_ > 512) ef_n_ = 512;                                  \
+        for (ef_i_ = 0; ef_i_ < ef_n_; ef_i_++)                        \
+            ef_flat[ef_i_] = (uint32_t)(uintptr_t)(arr)[ef_i_];         \
+        fn(ef_flat, ef_n_);                                            \
+    } while (0)
+#else
+#define EF_DRAW_LIST(fn, arr, n) fn((unsigned int*)(arr), (n))
